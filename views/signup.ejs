<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ELBASE — Sign Up</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; font-family: 'Poppins', sans-serif; }
    body {
      background-color: #f3f3f3;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 20px;
    }
    .error-banner {
      background-color: #f4a4a4;
      color: #a31616;
      border: 1.5px solid #a31616;
      border-radius: 999px;
      padding: 10px 24px;
      width: 100%;
      max-width: 380px;
      text-align: center;
      font-weight: 700;
      font-size: 14px;
      margin-bottom: 18px;
    }
    .card {
      background-color: #2438d8;
      color: #ffffff;
      width: 100%;
      max-width: 380px;
      padding: 40px 36px 36px;
      border-radius: 26px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.16);
    }
    .brand {
      font-size: 52px;
      font-weight: 900;
      text-align: center;
      margin: 0;
      line-height: 1;
      letter-spacing: -1px;
    }
    .subtitle {
      text-align: center;
      font-size: 13.5px;
      font-weight: 400;
      margin: 8px 0 32px;
      color: #eef1ff;
    }
    label {
      display: block;
      font-size: 13.5px;
      font-weight: 600;
      margin-bottom: 6px;
      margin-left: 2px;
    }
    input[type="text"],
    input[type="password"] {
      width: 100%;
      padding: 11px 18px;
      margin-bottom: 18px;
      background: transparent;
      border: 1.5px solid #f5e25b;
      border-radius: 999px;
      color: #ffffff;
      font-size: 13.5px;
      outline: none;
      transition: background-color 0.2s;
    }
    input::placeholder {
      color: rgba(255, 255, 255, 0.72);
    }
    input:focus {
      background-color: rgba(255, 255, 255, 0.08);
    }
    .btn-wrapper {
      text-align: center;
      margin-top: 14px;
    }
    button {
      background-color: #f5e25b;
      color: #2438d8;
      border: none;
      border-radius: 999px;
      padding: 10px 44px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: transform 0.15s, background-color 0.2s;
    }
    button:hover {
      background-color: #ffe94d;
      transform: translateY(-1px);
    }
    .link {
      text-align: center;
      margin-top: 16px;
      font-size: 13px;
      color: #ffffff;
    }
    .link a {
      color: #f5e25b;
      text-decoration: underline;
      font-weight: 500;
    }
  </style>
</head>
<body>

  <% if (error) { %>
    <div class="error-banner"><%= error %></div>
  <% } %>

  <div class="card">
    <h1 class="brand">ELBASE</h1>
    <p class="subtitle">Create your account!</p>

    <form method="POST" action="/signup">
      <label for="username">New Username</label>
      <input type="text" id="username" name="username" placeholder="Enter your new username" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Enter your password" required>

      <div class="btn-wrapper">
        <button type="submit">Create</button>
      </div>
    </form>

    <div class="link">
      Already have an account? <a href="/login">Log in</a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <script>
      const goToLogin = confirm(<%- JSON.stringify(success) %>);
      if (goToLogin) {
        window.location.href = '/login?next=/search';
      }
    </script>
  <% } %>

</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ELBASE — Search</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;900&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; font-family: 'Poppins', sans-serif; }
    body {
      background-color: #f5e25b;
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      padding: 40px 20px;
    }
    .logout {
      position: absolute;
      top: 32px;
      right: 40px;
      color: #dc2626;
      font-weight: 700;
      font-size: 16px;
      text-decoration: underline;
    }
    .logout:hover {
      color: #b91c1c;
    }
    .main-wrapper {
      width: 100%;
      max-width: 820px;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: auto 0;
    }
    .main-wrapper.has-query {
      margin-top: 90px;
      margin-bottom: auto;
    }
    .brand {
      font-size: 76px;
      font-weight: 900;
      color: #2438d8;
      margin: 0 0 24px;
      line-height: 1;
      letter-spacing: -1.5px;
      text-align: center;
    }
    .search-form {
      width: 100%;
      max-width: 580px;
      position: relative;
      display: flex;
      align-items: center;
    }
    .search-input {
      width: 100%;
      padding: 13px 52px 13px 24px;
      background-color: #f7f7f7;
      border: none;
      border-radius: 999px;
      font-size: 15.5px;
      font-weight: 500;
      color: #2438d8;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.14);
      outline: none;
    }
    .search-input::placeholder {
      color: #2438d8;
      opacity: 0.85;
    }
    .search-btn {
      position: absolute;
      right: 16px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000000;
    }
    .search-btn:hover {
      opacity: 0.7;
    }
    .table-card {
      width: 100%;
      margin-top: 38px;
      background-color: #f7f7f7;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    thead {
      background-color: #2438d8;
      color: #ffffff;
    }
    th {
      padding: 15px 28px;
      text-align: left;
      font-weight: 700;
      font-size: 15px;
    }
    td {
      padding: 16px 28px;
      font-size: 15px;
      font-weight: 500;
      color: #111111;
      border-bottom: 1px solid #e5e7eb;
    }
    tbody tr:last-child td {
      border-bottom: none;
    }
    .not-found {
      text-align: center;
      color: #6b7280;
      font-weight: 500;
      padding: 18px 28px;
    }
  </style>
</head>
<body>

  <a href="/login" class="logout">Log Out</a>

  <div class="main-wrapper <%= q ? 'has-query' : '' %>">
    <h1 class="brand">ELBASE</h1>

    <form class="search-form" method="GET" action="/search">
      <input
        type="text"
        name="q"
        class="search-input"
        placeholder="Name or NPM"
        value="<%= q %>"
        required
      >
      <button type="submit" class="search-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </form>

    <% if (q) { %>
      <div class="table-card">
        <table>
          <thead>
            <tr>
              <th style="width: 24%;">NPM</th>
              <th style="width: 48%;">Nama</th>
              <th style="width: 28%;">Program Studi</th>
            </tr>
          </thead>
          <tbody>
            <% if (results.length > 0) { %>
              <% results.forEach(student => { %>
                <tr>
                  <td><%= student.npm %></td>
                  <td><%= student.name %></td>
                  <td><%= student.major %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3" class="not-found">Data not found!</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</body>
</html>